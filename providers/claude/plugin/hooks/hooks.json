{
  "description": "feedback-eval experiment: Stop + SubagentStop + PostToolUse treatment for stripe feedback steering. Permissive eligibility -- any mention of Stripe qualifies.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/stop.mjs"],
            "timeout": 10,
            "statusMessage": "Checking for Stripe feedback..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/subagent-stop.mjs"],
            "timeout": 10,
            "statusMessage": "Checking for Stripe feedback..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use.mjs"],
            "if": "mcp__plugin_stripe_stripe__*",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session-end.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
